#!/usr/bin/env python3
"""
notch-language-helper: Backend for Language & Input management in Hyprland and Quickshell.
Supports:
  - Querying input layouts, active layout, switch shortcuts, and system/user locales.
  - Adding, removing, and switching keyboard layouts in real time.
  - Setting input switch hotkeys (XKB grp options).
  - Setting user and system display languages.
  - Persisting all changes to hyprland.lua, hyprland.conf, and environment configs.
"""

import os
import sys
import json
import re
import socket
import subprocess
from pathlib import Path

