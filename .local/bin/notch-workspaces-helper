#!/usr/bin/env python3
import sys
import os
import subprocess
import json
import glob
import re
import time
import socket
from concurrent.futures import ThreadPoolExecutor

TARGET_UID = os.environ.get("SUDO_UID") or os.environ.get("NOTCH_UID")
if not TARGET_UID:
    if os.getuid() == 0 and os.path.exists("/run/user/1000"):
        TARGET_UID = "1000"
    else:
        TARGET_UID = str(os.getuid())

xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{TARGET_UID}")
os.environ["XDG_RUNTIME_DIR"] = xdg_runtime

if "WAYLAND_DISPLAY" not in os.environ:
    wls = [f for f in glob.glob(f"{xdg_runtime}/wayland-*") if re.match(r"^wayland-\d+$", os.path.basename(f))]
    if wls:
        wls.sort(key=os.path.getmtime, reverse=True)
        os.environ["WAYLAND_DISPLAY"] = os.path.basename(wls[0])
    else:
        os.environ["WAYLAND_DISPLAY"] = "wayland-1"

def hypr_socket_path():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    candidates = [
        f"{xdg_runtime}/hypr/{sig}/.socket.sock",
        f"/tmp/hypr/{sig}/.socket.sock",
    ]
    for c in candidates:
        if os.path.exists(c):
            return c
    hypr_dir = f"{xdg_runtime}/hypr"
    if os.path.isdir(hypr_dir):
        for d in os.listdir(hypr_dir):
            p = os.path.join(hypr_dir, d, ".socket.sock")
            if os.path.exists(p):
                return p
    return None

def ensure_hypr_env():
    if "HYPRLAND_INSTANCE_SIGNATURE" not in os.environ:
        hypr_dir = f"{xdg_runtime}/hypr"
        if os.path.isdir(hypr_dir):
            sigs = [d for d in os.listdir(hypr_dir) if os.path.exists(os.path.join(hypr_dir, d, ".socket.sock"))]
            if sigs:
                sigs.sort(key=lambda s: os.path.getmtime(os.path.join(hypr_dir, s)), reverse=True)
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]

ensure_hypr_env()

def hypr_socket_request(cmd):
    p = hypr_socket_path()
    if not p:
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.3)
        s.connect(p)
        payload = (cmd if cmd.endswith("\n") else cmd + "\n").encode("utf-8")
        s.sendall(payload)
        chunks = []
        while True:
            chunk = s.recv(8192)
            if not chunk:
                break
            chunks.append(chunk)
        s.close()
        return b"".join(chunks).decode("utf-8", errors="replace")
    except Exception:
        return None

def run_hyprctl(args):
    ensure_hypr_env()
    try:
        res = subprocess.run(["hyprctl"] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=2)
        return res.stdout
    except Exception:
        return ""

def run_hypr_json(req):
    res = hypr_socket_request(f"j/{req}")
    if res:
        try:
            return json.loads(res)
        except Exception:
            pass
    raw = run_hyprctl(["-j", req])
    try:
        return json.loads(raw)
    except Exception:
        return []

def hypr_dispatch_lua(lua):
    res = hypr_socket_request(f"dispatch {lua}")
    if res and res.strip().startswith("ok") and "error" not in res.lower():
        return True
    res = hypr_socket_request(f"eval hl.dispatch({lua})")
    if res and res.strip().startswith("ok") and "error" not in res.lower():
        return True
    return False

def hypr_focus_monitor(mon):
    if not mon:
        return
    if not hypr_dispatch_lua(f'hl.dsp.focus({{monitor="{mon}"}})'):
        run_hyprctl(["dispatch", "focusmonitor", str(mon)])

def hypr_focus_workspace(target_id):
    try:
        wid = int(target_id)
        lua = f"hl.dsp.focus({{workspace={wid}}})"
    except ValueError:
        lua = f'hl.dsp.focus({{workspace="{target_id}"}})'
    if not hypr_dispatch_lua(lua):
        run_hyprctl(["dispatch", "workspace", str(target_id)])

APP_MAP = {
    "kitty": ("󰞷", "Kitty"),
    "alacritty": ("󰞷", "Alacritty"),
    "foot": ("󰞷", "Foot"),
    "ghostty": ("󰞷", "Ghostty"),
    "xterm": ("󰞷", "Terminal"),
    "brave-origin-nightly": ("󰖟", "Brave Nightly"),
    "brave-browser": ("󰖟", "Brave"),
    "brave": ("󰖟", "Brave"),
    "firefox": ("󰈹", "Firefox"),
    "chromium": ("󰖟", "Chromium"),
    "google-chrome": ("󰊯", "Chrome"),
    "code": ("󰨞", "VS Code"),
    "code-oss": ("󰨞", "Code - OSS"),
    "vscodium": ("󰨞", "VSCodium"),
    "cursor": ("󰨞", "Cursor"),
    "discord": ("󰙯", "Discord"),
    "webcord": ("󰙯", "Webcord"),
    "vesktop": ("󰙯", "Vesktop"),
    "telegram-desktop": ("󰒱", "Telegram"),
    "slack": ("󰒱", "Slack"),
    "spotify": ("󰓇", "Spotify"),
    "steam": ("󰓓", "Steam"),
    "lutris": ("󰓓", "Lutris"),
    "heroic": ("󰓓", "Heroic"),
    "thunar": ("󰉋", "Thunar"),
    "nautilus": ("󰉋", "Files"),
    "dolphin": ("󰉋", "Dolphin"),
    "pavucontrol": ("󰕾", "Audio"),
    "mpv": ("󰕼", "MPV"),
    "vlc": ("󰕼", "VLC"),
    "obs": ("󰑋", "OBS"),
    "gimp": ("󰽉", "GIMP"),
    "inkscape": ("󰽉", "Inkscape"),
    "blender": ("󰽉", "Blender"),
}

def resolve_app(app_class, title=""):
    cl = (app_class or "").lower().strip()
    if cl in APP_MAP:
        return APP_MAP[cl]
    for k, (icon, name) in APP_MAP.items():
        if k in cl:
            return (icon, name)
    if "term" in cl:
        return ("󰞷", app_class)
    if "browser" in cl or "web" in cl:
        return ("󰖟", app_class)
    if "edit" in cl or "code" in cl:
        return ("󰨞", app_class)
    return ("󰘔", app_class if app_class else "Application")

def get_current_buf():
    buf_file = f"/tmp/hypr_screen_{TARGET_UID}_buf"
    try:
        if os.path.exists(buf_file):
            with open(buf_file, "r") as f:
                b = f.read().strip()
                if b in ("1", "2"):
                    return b
    except Exception:
        pass
    return "1"

def capture_screens():
    curr_buf = get_current_buf()
    next_buf = "2" if curr_buf == "1" else "1"

    monitors_raw = run_hypr_json("monitors")

    def cap_mon(m):
        mname = m.get("name")
        if not mname:
            return
        screen_file = f"/tmp/hypr_screen_{TARGET_UID}_{mname}_{next_buf}.png"
        try:
            # -l 0 for 0 compression = instantaneous write like rust-dock
            subprocess.run(["grim", "-s", "0.25", "-l", "0", "-t", "png", "-o", mname, screen_file],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=os.environ, timeout=0.8)
            if os.getuid() == 0:
                try:
                    os.chmod(screen_file, 0o666)
                except Exception:
                    pass
        except Exception:
            pass

    with ThreadPoolExecutor(max_workers=4) as ex:
        list(ex.map(cap_mon, monitors_raw))

    buf_file = f"/tmp/hypr_screen_{TARGET_UID}_buf"
    try:
        with open(buf_file, "w") as f:
            f.write(next_buf)
        if os.getuid() == 0:
            try:
                os.chmod(buf_file, 0o666)
            except Exception:
                pass
    except Exception:
        pass
    return next_buf

def list_workspaces():
    ws_raw = run_hypr_json("workspaces")
    clients_raw = run_hypr_json("clients")
    monitors_raw = run_hypr_json("monitors")
    active_ws_raw = run_hypr_json("activeworkspace")
    active_id = active_ws_raw.get("id", 1) if isinstance(active_ws_raw, dict) else 1

    mon_by_id = {m.get("id"): m for m in monitors_raw}
    mon_by_name = {m.get("name"): m for m in monitors_raw}
    default_mon = monitors_raw[0] if monitors_raw else {"x": 0, "y": 0, "width": 1920, "height": 1080}

    # Extract all existing workspace ids
    existing_ids = set()
    for w in ws_raw:
        if isinstance(w.get("id"), int) and w.get("id") > 0:
            existing_ids.add(w.get("id"))
    if isinstance(active_id, int) and active_id > 0:
        existing_ids.add(active_id)

    # Next available workspace id
    next_id = 1
    while next_id in existing_ids:
        next_id += 1

    # Build workspace map
    ws_dict = {}
    for w in ws_raw:
        wid = w.get("id")
        if not isinstance(wid, int) or wid <= 0:
            continue
        ws_dict[wid] = {
            "id": wid,
            "name": str(w.get("name", wid)),
            "monitor": str(w.get("monitor", "")),
            "is_active": (wid == active_id),
            "windows_count": w.get("windows", 0),
            "clients": []
        }

    # Ensure active workspace is in the list even if empty
    if active_id > 0 and active_id not in ws_dict:
        active_monitor = active_ws_raw.get("monitor", "")
        ws_dict[active_id] = {
            "id": active_id,
            "name": str(active_ws_raw.get("name", active_id)),
            "monitor": active_monitor,
            "is_active": True,
            "windows_count": 0,
            "clients": []
        }

    # Group clients and calculate relative positions
    visible_clients_to_cap = []
    for c in clients_raw:
        cw = c.get("workspace", {})
        wid = cw.get("id") if isinstance(cw, dict) else None
        if wid is None or wid not in ws_dict:
            continue

        cl_class = c.get("class", "")
        cl_title = c.get("title", "")
        addr = c.get("address", "")
        addr_clean = addr.replace("0x", "")
        icon, app_name = resolve_app(cl_class, cl_title)

        # Monitor bounds
        mon = mon_by_id.get(c.get("monitor")) or mon_by_name.get(ws_dict[wid]["monitor"]) or default_mon
        mx = mon.get("x", 0)
        my = mon.get("y", 0)
        mw = max(1, mon.get("width", 1920))
        mh = max(1, mon.get("height", 1080))

        cx, cy = c.get("at", [0, 0])
        cw_px, ch_px = c.get("size", [mw, mh])

        rx = max(0.0, min(0.95, (cx - mx) / mw))
        ry = max(0.0, min(0.95, (cy - my) / mh))
        rw = max(0.05, min(1.0, cw_px / mw))
        rh = max(0.05, min(1.0, ch_px / mh))

        time_tag = int(time.time() * 100)
        thumb_file = f"/tmp/hypr_win_{TARGET_UID}_{addr_clean}.png"
        thumb_url = f"{thumb_file}?v={time_tag}"

        client_entry = {
            "address": addr,
            "clean_addr": addr_clean,
            "thumb": thumb_url,
            "thumb_file": thumb_file,
            "class": cl_class,
            "title": cl_title,
            "icon": icon,
            "app_name": app_name,
            "pid": c.get("pid", 0),
            "floating": bool(c.get("floating", False)),
            "is_focused": (c.get("focusHistoryID", -1) == 0),
            "rel_x": rx,
            "rel_y": ry,
            "rel_w": rw,
            "rel_h": rh
        }
        ws_dict[wid]["clients"].append(client_entry)

    curr_buf = get_current_buf()
    any_screen_exists = any(os.path.exists(f"/tmp/hypr_screen_{TARGET_UID}_{m.get('name', '')}_{curr_buf}.png") for m in monitors_raw)
    if not any_screen_exists and monitors_raw:
        curr_buf = capture_screens()

    for wid, data in ws_dict.items():
        mon_name = data.get("monitor", "")
        screen_file = f"/tmp/hypr_screen_{TARGET_UID}_{mon_name}_{curr_buf}.png"
        if os.path.exists(screen_file):
            data["preview"] = screen_file
        else:
            data["preview"] = ""

    # Update actual window count from clients list if higher
    for wid, data in ws_dict.items():
        if len(data["clients"]) > data["windows_count"]:
            data["windows_count"] = len(data["clients"])

    # Sort workspaces by ID
    sorted_ws = [ws_dict[k] for k in sorted(ws_dict.keys())]

    output = {
        "active_id": active_id,
        "next_id": next_id,
        "count": len(sorted_ws),
        "workspaces": sorted_ws
    }
    print(json.dumps(output))

def collapse_island():
    qml_path = os.path.expanduser("~/.config/quickshell/waybar-island/shell.qml")
    try:
        subprocess.run(["quickshell", "ipc", "-p", qml_path, "--any-display", "call", "island", "collapse", ""],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=os.environ, timeout=1)
    except Exception:
        pass

def add_workspace(target_id=None):
    if target_id is None:
        ws_raw = run_hypr_json("workspaces")
        existing_ids = {w.get("id") for w in ws_raw if isinstance(w.get("id"), int) and w.get("id") > 0}
        cand = 1
        while cand in existing_ids:
            cand += 1
        target_id = cand

    hypr_focus_workspace(target_id)
    print(json.dumps({"status": "created", "id": target_id}))

def remove_workspace(target_id):
    try:
        wid = int(target_id)
    except ValueError:
        print(json.dumps({"status": "error", "message": "invalid id"}))
        return

    clients_raw = run_hypr_json("clients")
    ws_raw = run_hypr_json("workspaces")
    active_ws_raw = run_hypr_json("activeworkspace")
    active_id = active_ws_raw.get("id", 1) if isinstance(active_ws_raw, dict) else 1

    closed = 0
    for c in clients_raw:
        cw = c.get("workspace", {})
        if isinstance(cw, dict) and cw.get("id") == wid:
            addr = c.get("address", "")
            if addr:
                close_window(addr)
                closed += 1

    if active_id == wid:
        remaining = [w.get("id") for w in ws_raw if isinstance(w.get("id"), int) and w.get("id") > 0 and w.get("id") != wid]
        new_target = remaining[0] if remaining else (1 if wid != 1 else 2)
        switch_workspace(new_target)

    print(json.dumps({"status": "removed", "id": wid, "closed_windows": closed}))

def switch_workspace(target_id):
    try:
        wid = int(target_id)
    except ValueError:
        wid = target_id

    target_mon = None
    ws_raw = run_hypr_json("workspaces")
    for w in ws_raw:
        if str(w.get("id")) == str(wid):
            target_mon = w.get("monitor")
            break

    if target_mon:
        hypr_focus_monitor(target_mon)

    hypr_focus_workspace(wid)
    collapse_island()
    print(json.dumps({"status": "switched", "id": target_id, "monitor": target_mon}))

def focus_window(ws_id=None, address=""):
    if address:
        addr = address if address.startswith("address:") else f"address:{address}"
        if not hypr_dispatch_lua(f'hl.dsp.focus({{window="{addr}"}})'):
            run_hyprctl(["dispatch", "focuswindow", addr])
    if ws_id is not None:
        hypr_focus_workspace(ws_id)
    collapse_island()

def close_window(address):
    addr = address if address.startswith("address:") else f"address:{address}"
    if not hypr_dispatch_lua(f'hl.dsp.window.close({{window="{addr}"}})'):
        run_hyprctl(["dispatch", "closewindow", addr])
    print(json.dumps({"status": "closed", "address": address}))

def is_overview_open(mon_name=""):
    qml_path = os.path.expanduser("~/.config/quickshell/waybar-island/shell.qml")
    cmd = ["quickshell", "ipc", "-p", qml_path, "--any-display", "call", "island", "state", mon_name or ""]
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=os.environ, timeout=1.0)
        st = json.loads(res.stdout.strip())
        return st.get("expanded", False) and st.get("tab") == 4
    except Exception:
        return False

def toggle_overview():
    mons = run_hypr_json("monitors")
    focused_mon = None
    for m in mons:
        if m.get("focused"):
            focused_mon = m.get("name")
            break
    if not focused_mon and mons:
        focused_mon = mons[0].get("name")

    qml_path = os.path.expanduser("~/.config/quickshell/waybar-island/shell.qml")
    cmd = ["quickshell", "ipc", "-p", qml_path, "--any-display", "call", "island", "toggleWorkspaces", focused_mon or ""]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=os.environ, timeout=1.5)
    except Exception:
        pass

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "list":
        list_workspaces()
    elif cmd == "toggle":
        toggle_overview()
    elif cmd == "refresh" or cmd == "capture":
        capture_screens()
        list_workspaces()
    elif cmd == "add":
        target = sys.argv[2] if len(sys.argv) > 2 else None
        add_workspace(target)
    elif cmd == "remove":
        if len(sys.argv) > 2:
            remove_workspace(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "missing workspace id"}))
    elif cmd == "switch":
        if len(sys.argv) > 2:
            switch_workspace(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "missing workspace id"}))
    elif cmd == "focus_window":
        ws_id = sys.argv[2] if len(sys.argv) > 2 else 1
        addr = sys.argv[3] if len(sys.argv) > 3 else ""
        focus_window(ws_id, addr)
    elif cmd == "close_window":
        if len(sys.argv) > 2:
            close_window(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "missing address"}))
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
