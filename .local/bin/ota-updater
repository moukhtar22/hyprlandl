#!/usr/bin/env bash
# ota-updater: Wrapper delegating to system-ota
# Kept for backward compatibility across scripts, commands, and shortcuts.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"

if [ -x "$SCRIPT_DIR/system-ota" ] && [ "$(readlink -f "$SCRIPT_DIR/system-ota" 2>/dev/null)" != "$SELF" ]; then
    exec "$SCRIPT_DIR/system-ota" "$@"
elif [ -x "$HOME/.local/bin/system-ota" ] && [ "$(readlink -f "$HOME/.local/bin/system-ota" 2>/dev/null)" != "$SELF" ]; then
    exec "$HOME/.local/bin/system-ota" "$@"
elif command -v system-ota >/dev/null 2>&1 && [ "$(readlink -f "$(command -v system-ota)" 2>/dev/null)" != "$SELF" ]; then
    exec system-ota "$@"
else
    echo "Error: system-ota executable not found or circular reference detected." >&2
    exit 1
fi
